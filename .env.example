# AI Image Detector - Environment Variables Template
# Copy this file to .env and replace with your actual values:
# cp .env.example .env
# Or generate automatically using: python generate_admin_hash.py

# Random 64-character secret key for secure Flask sessions and CSRF protection
SECRET_KEY=replace_with_a_secure_random_hex_key_here

# Single administrator account credentials (no public registration exists)
ADMIN_USERNAME=admin

# Werkzeug scrypt or pbkdf2 password hash (generate using: python generate_admin_hash.py)
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$replace_with_your_hashed_admin_password

# Maximum upload size in bytes (default: 10 MB = 10485760 bytes)
MAX_CONTENT_LENGTH=10485760
